<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Pages : fond crème, pas de barre de navigation native -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

    <!-- Typographie : Outfit pour les titres, Inter pour le texte -->
    <Style x:Key="Titre" TargetType="Label">
        <Setter Property="FontFamily" Value="OutfitSemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>
    <Style x:Key="TitreAccueil" TargetType="Label" BasedOn="{StaticResource Titre}">
        <Setter Property="FontSize" Value="36" />
    </Style>
    <Style x:Key="Intro" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource EncreDouce}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="SectionTitre" TargetType="Label">
        <Setter Property="FontFamily" Value="OutfitSemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>
    <Style x:Key="Libelle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
    </Style>
    <Style x:Key="Surtitre" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Terracotta}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>
    <Style x:Key="Note" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource EncreDouce}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="Erreur" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Erreur}" />
    </Style>
    <Style x:Key="Lien" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Terracotta}" />
    </Style>
    <Style x:Key="Icone" TargetType="Label">
        <Setter Property="FontFamily" Value="Lucide" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource EncreDouce}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Cartes et champs -->
    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="{StaticResource Bordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>
    <Style x:Key="Champ" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="{StaticResource Bordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="HeightRequest" Value="54" />
    </Style>
    <Style x:Key="Conseil" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Creme}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Encre}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource EncreDouce}" />
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Boutons -->
    <Style x:Key="BoutonPrincipal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Terracotta}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="TextTransform" Value="None" />
        <Setter Property="ContentLayout" Value="Right,10" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Bordure}" />
                            <Setter Property="TextColor" Value="{StaticResource EncreDouce}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource BoutonPrincipal}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Terracotta}" />
        <Setter Property="BorderColor" Value="{StaticResource Bordure}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Icônes de boutons (police Lucide) -->
    <FontImageSource x:Key="IcoFlecheBlanche" FontFamily="Lucide" Glyph="&#xE049;" Color="White" Size="18" />
    <FontImageSource x:Key="IcoEchangeBlanc" FontFamily="Lucide" Glyph="&#xE24A;" Color="White" Size="18" />

</ResourceDictionary>
