<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:NutriCam.Controls" xmlns:h="clr-namespace:NutriCam.Helpers" xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls" ios:Page.UseSafeArea="True"
             x:Class="NutriCam.Views.ReglagesPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppHeader ShowBack="False" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,18,24,16" Spacing="24">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Votre espace" Style="{StaticResource Titre}" />
                    <Label Text="Retrouvez et modifiez ce que vous nous avez confié." Style="{StaticResource Intro}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Carte}" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" StrokeThickness="0"
                                BackgroundColor="{StaticResource Terracotta}">
                            <Label Text="{Binding Initial}" FontFamily="OutfitSemiBold" FontSize="22" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding FirstName}" FontFamily="OutfitSemiBold" FontSize="20" TextColor="{StaticResource Encre}" />
                            <Label Text="{Binding Email}" Style="{StaticResource Note}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Mon programme" Style="{StaticResource SectionTitre}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Carte}" Padding="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Fond}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                            <Label Text="{Binding Glyph}" Style="{StaticResource Icone}" FontSize="20"
                                                   TextColor="{StaticResource Terracotta}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontFamily="InterSemiBold" FontSize="15" TextColor="{StaticResource Encre}" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Note}" FontSize="13" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{x:Static h:Icons.ChevronRight}" Style="{StaticResource Icone}" VerticalOptions="Center" />
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Compte et données" Style="{StaticResource SectionTitre}" />
                    <Button Text="Se déconnecter" Style="{StaticResource BoutonSecondaire}" Command="{Binding LogoutCommand}" />
                    <Button Text="Supprimer mon compte et mes données" Style="{StaticResource BoutonSecondaire}"
                            TextColor="{StaticResource Erreur}" BorderColor="{StaticResource Erreur}"
                            Command="{Binding DeleteAccountCommand}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Conseil}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="{x:Static h:Icons.Info}" Style="{StaticResource Icone}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Style="{StaticResource Note}"
                               Text="NutriCam propose des repères alimentaires généraux. Ce n’est pas un avis médical : en cas de grossesse, de maladie ou d’allergie sévère, parlez-en à un professionnel de santé." />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="2" Active="profil" />
    </Grid>
</ContentPage>
