<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NutriCam.Controls"
             xmlns:h="clr-namespace:NutriCam.Helpers"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="NutriCam.Views.ProfilPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppHeader ShowBack="True" />

        <ScrollView x:Name="Scroller" Grid.Row="1">
            <VerticalStackLayout Padding="24,18,24,16" Spacing="24">
                <controls:ProgressSteps Step="1" />
                <VerticalStackLayout Spacing="10">
                    <Label Text="Parlez-nous de vous" Style="{StaticResource Titre}" />
                    <Label Text="Quelques repères pour adapter votre programme à votre quotidien."
                           Style="{StaticResource Intro}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <controls:FormField x:Name="AgeField" Title="Âge" Placeholder="Votre âge" Suffix="ans" KeyboardType="Numeric"
                                            Text="{Binding AgeText, Mode=TwoWay}" Error="{Binding AgeError}" />
                        <controls:FormField x:Name="HeightField" Grid.Column="1" Title="Taille" Placeholder="Votre taille" Suffix="cm" KeyboardType="Numeric"
                                            Text="{Binding HeightText, Mode=TwoWay}" Error="{Binding HeightError}" />
                    </Grid>
                    <controls:FormField x:Name="WeightField" Title="Poids" Placeholder="Votre poids" Suffix="kg" KeyboardType="Numeric"
                                        Text="{Binding WeightText, Mode=TwoWay}" Error="{Binding WeightError}" />

                    <VerticalStackLayout x:Name="SexBlock" Spacing="8">
                        <Label Text="Sexe" Style="{StaticResource Libelle}" />
                        <controls:SegmentedControl Items="Femme,Homme" SelectedIndex="{Binding SexIndex, Mode=TwoWay}" />
                        <Label Text="{Binding SexError}" Style="{StaticResource Erreur}"
                               IsVisible="{Binding SexError, Converter={StaticResource NotEmpty}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ActivityBlock" Spacing="8">
                        <Label Text="Niveau d’activité" Style="{StaticResource Libelle}" />
                        <controls:SegmentedControl Items="Faible,Modéré,Élevé" SelectedIndex="{Binding ActivityIndex, Mode=TwoWay}" />
                        <Label Text="{Binding ActivityError}" Style="{StaticResource Erreur}"
                               IsVisible="{Binding ActivityError, Converter={StaticResource NotEmpty}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="MealsBlock" Spacing="8">
                        <Label Text="Repas par jour" Style="{StaticResource Libelle}" />
                        <controls:SegmentedControl Items="2 repas,3 repas,4 repas,5 repas" SelectedIndex="{Binding MealsIndex, Mode=TwoWay}" />
                        <Label Text="{Binding MealsError}" Style="{StaticResource Erreur}"
                               IsVisible="{Binding MealsError, Converter={StaticResource NotEmpty}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="HealthBlock" Spacing="12">
                    <Label Text="Votre santé" Style="{StaticResource SectionTitre}" />
                    <Label Text="Êtes-vous concerné(e) par l’une de ces situations ? Dans ce cas, un suivi médical est nécessaire."
                           Style="{StaticResource Note}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Conditions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Champ}" HeightRequest="-1" MinimumHeightRequest="50" Padding="10,2">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Color="{StaticResource Terracotta}"
                                                  VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Label}" FontFamily="InterRegular" FontSize="14"
                                               TextColor="{StaticResource Encre}" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding HealthError}" Style="{StaticResource Erreur}"
                           IsVisible="{Binding HealthError, Converter={StaticResource NotEmpty}}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Conseil}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="{x:Static h:Icons.LockKeyhole}" Style="{StaticResource Icone}" VerticalOptions="Start" />
                        <Label Grid.Column="1" Style="{StaticResource Note}"
                               Text="Ces informations servent uniquement à personnaliser vos repères alimentaires. NutriCam ne remplace pas un avis médical." />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="24,12,24,20">
            <Button Text="Continuer" Style="{StaticResource BoutonPrincipal}"
                    ImageSource="{StaticResource IcoFlecheBlanche}" Command="{Binding ContinueCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
