<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NutriCam.Controls"
             xmlns:h="clr-namespace:NutriCam.Helpers"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="NutriCam.Views.InscriptionPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <controls:AppHeader ShowBack="True" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,18,24,16" Spacing="24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bienvenue à votre table." Style="{StaticResource Titre}" />
                    <Label Text="Créons votre compte. Quelques secondes suffisent." Style="{StaticResource Intro}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="20">
                    <controls:FormField Title="Prénom" Placeholder="Votre prénom"
                                        Text="{Binding FirstName, Mode=TwoWay}" Error="{Binding FirstNameError}" />
                    <controls:FormField Title="E-mail" Placeholder="Votre adresse e-mail"
                                        Text="{Binding Email, Mode=TwoWay}" Error="{Binding EmailError}"
                                        KeyboardType="Email" LeadingGlyph="{x:Static h:Icons.Mail}" />
                    <controls:FormField Title="Mot de passe" Placeholder="8 caractères minimum"
                                        Text="{Binding Password, Mode=TwoWay}" Error="{Binding PasswordError}"
                                        IsPasswordField="True" />
                    <controls:FormField Title="Confirmer le mot de passe" Placeholder="Saisissez-le à nouveau"
                                        Text="{Binding Confirmation, Mode=TwoWay}" Error="{Binding ConfirmationError}"
                                        IsPasswordField="True" />
                </VerticalStackLayout>
                <Label Text="Votre compte vous permet de retrouver votre programme et vos préférences."
                       Style="{StaticResource Note}" />
                <Label Text="{Binding FormError}" Style="{StaticResource Erreur}"
                       IsVisible="{Binding FormError, Converter={StaticResource NotEmpty}}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="24,12,24,20" Spacing="18">
            <Button Text="{Binding RegisterText}" Style="{StaticResource BoutonPrincipal}"
                    ImageSource="{StaticResource IcoFlecheBlanche}"
                    Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotBusy}" />
            <Label Text="J’ai déjà un compte" Style="{StaticResource Lien}" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding HaveAccountCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
