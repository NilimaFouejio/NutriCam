<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NutriCam.Controls"
             xmlns:h="clr-namespace:NutriCam.Helpers"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             ios:Page.UseSafeArea="True"
             x:Class="NutriCam.Views.BudgetPage">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto">
            <controls:AppHeader ShowBack="True" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="24,18,24,16" Spacing="24">
                    <controls:ProgressSteps Step="4" />
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Des repas pour votre quotidien" Style="{StaticResource Titre}" />
                        <Label Text="Avec ce que vous trouvez près de chez vous, et un budget qui vous convient."
                               Style="{StaticResource Intro}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Votre budget" Style="{StaticResource SectionTitre}" />
                        <controls:SegmentedControl Items="Économique,Moyen,Confort" SelectedIndex="{Binding BudgetIndex, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Faciles à trouver près de vous" Style="{StaticResource SectionTitre}" />
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start"
                                    BindableLayout.ItemsSource="{Binding Available}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <controls:ChipView Text="{Binding Label}" IsSelected="{Binding IsSelected}"
                                                       Command="{Binding ToggleCommand}" Margin="0,0,8,8" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding AvailableError}" Style="{StaticResource Erreur}"
                               IsVisible="{Binding AvailableError, Converter={StaticResource NotEmpty}}" />
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource Teinte}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 18" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static h:Icons.Utensils}" Style="{StaticResource Icone}"
                                       TextColor="{StaticResource Terracotta}" />
                                <Label Text="{Binding GoalLabel}" FontFamily="InterSemiBold" FontSize="14"
                                       TextColor="{StaticResource Encre}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Summary}" Style="{StaticResource Note}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Padding="24,12,24,20" Spacing="14">
                <Button Text="{Binding GenerateText}" Style="{StaticResource BoutonPrincipal}"
                        ImageSource="{StaticResource IcoFlecheBlanche}"
                        Command="{Binding GenerateCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Label Text="Vos choix restent modifiables." Style="{StaticResource Note}"
                       FontSize="13" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Écran d'attente pendant la génération -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#E6FAF6F0">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Terracotta}" />
                <Label Text="Nous composons votre semaine…" Style="{StaticResource SectionTitre}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
