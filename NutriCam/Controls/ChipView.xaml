<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriCam.Controls.ChipView">
    <Border x:Name="Pill" HeightRequest="38" StrokeThickness="1" StrokeShape="RoundRectangle 19"
            Padding="13,0">
        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
            <Label x:Name="Mark" Style="{StaticResource Icone}" FontSize="13" IsVisible="False"
                   TextColor="{StaticResource Terracotta}" />
            <Label x:Name="Caption" FontSize="13" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
