<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="NutriCam.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:NutriCam.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <!-- Pages racines : on y accède par navigation absolue (//route) -->
    <ShellContent Route="accueil" ContentTemplate="{DataTemplate views:AccueilPage}" />
    <ShellContent Route="dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" />
    <ShellContent Route="programme" ContentTemplate="{DataTemplate views:ProgrammePage}" />
    <ShellContent Route="reglages" ContentTemplate="{DataTemplate views:ReglagesPage}" />

</Shell>
